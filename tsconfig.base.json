{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"resolveJsonModule": true,
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["node", "vite/client"],
		"lib": ["ES2022", "DOM", "DOM.Iterable"]
	}
}
