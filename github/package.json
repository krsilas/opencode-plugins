{
	"name": "opencode-pull-requests",
	"version": "0.1.0",
	"description": "OpenCode plugin: GitHub pull request panel, composer pill and pull request browser.",
	"keywords": [
		"github",
		"opencode",
		"opencode-plugin",
		"pull-requests"
	],
	"license": "SEE LICENSE IN LICENSE",
	"author": "Silas Krause",
	"files": [
		"src/*.ts",
		"dist"
	],
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./gui-experimental": "./dist/gui-experimental.cjs",
		"./rpc": "./src/rpc.ts"
	},
	"scripts": {
		"build": "vp build",
		"dev": "vp build --watch",
		"lint": "vp lint --deny-warnings src tests vite.config.ts",
		"lint:fix": "vp lint --fix --deny-warnings src tests vite.config.ts",
		"format": "vp fmt src tests vite.config.ts",
		"format:check": "vp fmt --check src tests vite.config.ts",
		"typecheck": "tsc --noEmit",
		"test": "node --test tests/*.test.ts",
		"prepack": "vp run build",
		"prepublishOnly": "vp run typecheck && vp run test"
	},
	"dependencies": {
		"@octokit/core": "catalog:",
		"@opencode/plugin": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"solid-js": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plugin-solid": "catalog:",
		"vite-plus": "catalog:"
	}
}
