{
	"name": "opencode-figma",
	"version": "0.1.1",
	"description": "OpenCode plugin: Figma files in a session's side panel, with annotated areas attached to the prompt.",
	"keywords": [
		"figma",
		"opencode",
		"opencode-plugin"
	],
	"license": "SEE LICENSE IN LICENSE",
	"author": "Silas Krause",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/krsilas/opencode-plugins.git",
		"directory": "figma"
	},
	"files": [
		"src/*.ts",
		"dist"
	],
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./gui-experimental": "./dist/gui-experimental.cjs",
		"./rpc": "./src/rpc.ts"
	},
	"scripts": {
		"build": "vp build",
		"dev": "vp build --watch",
		"lint": "vp lint --deny-warnings src tests vite.config.ts",
		"lint:fix": "vp lint --fix --deny-warnings src tests vite.config.ts",
		"format": "vp fmt src tests vite.config.ts",
		"format:check": "vp fmt --check src tests vite.config.ts",
		"typecheck": "tsc --noEmit",
		"test": "node --test tests/*.test.ts",
		"prepack": "vp run build",
		"prepublishOnly": "vp run typecheck && vp run test"
	},
	"dependencies": {
		"@opencode/plugin": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"effect": "catalog:",
		"electron": "^38.0.0",
		"solid-js": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plugin-solid": "catalog:",
		"vite-plus": "catalog:"
	},
	"peerDependencies": {
		"effect": "^4.0.0"
	}
}
